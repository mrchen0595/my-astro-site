---
import { getCollection, render, type CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import StructuredData from "../../components/StructuredData.astro";

import { createPageTitle } from "../../lib/seo";

import { createProjectStructuredData } from "../../lib/structured-data";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      id: project.id,
    },

    props: {
      project,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { title, description, technologies, status, href } = project.data;

const { Content } = await render(project);

const baseURL = Astro.site ?? Astro.url.origin;

const projectPageURL = new URL(`/projects/${project.id}`, baseURL).href;

const authorURL = new URL("/about", baseURL).href;

const projectStructuredData = createProjectStructuredData({
  title,
  description,

  pageUrl: projectPageURL,

  technologies,

  status,

  authorUrl: authorURL,
});
---

<BaseLayout title={createPageTitle(title)} description={description}>
  <StructuredData data={projectStructuredData} />

  <Header />

  <main>
    <a class="back-link" href="/projects"> ← 返回项目列表 </a>

    <section class="project-hero">
      <p class="label">PROJECT CASE STUDY</p>

      <div class="title-row">
        <h1>
          {title}
        </h1>

        <span class="status">
          {status}
        </span>
      </div>

      <p class="description">
        {description}
      </p>

      <ul class="technology-list" aria-label={`${title} 使用的技术`}>
        {technologies.map((technology) => <li>{technology}</li>)}
      </ul>

      {
        href ? (
          <a class="project-button" href={href}>
            打开项目
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <p class="unavailable">当前项目暂未开放。</p>
        )
      }
    </section>

    <div class="divider"></div>

    <article class="case-study">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  main {
    width: min(900px, calc(100% - 40px));

    margin: 0 auto;

    padding: 60px 0 110px;
  }

  .back-link {
    display: inline-flex;

    align-items: center;

    margin-bottom: 56px;

    color: var(--color-muted);

    font-weight: 700;

    text-decoration: none;

    transition: color 160ms ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .project-hero {
    max-width: 850px;
  }

  .label {
    margin: 0;

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  .title-row {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 28px;

    margin-top: 16px;
  }

  h1 {
    margin: 0;

    color: var(--color-text);

    font-size: clamp(46px, 8vw, 76px);

    line-height: 1.05;

    letter-spacing: -0.055em;
  }

  .status {
    flex-shrink: 0;

    margin-top: 10px;

    padding: 8px 12px;

    border-radius: 999px;

    background: var(--color-accent-soft);

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    white-space: nowrap;
  }

  .description {
    max-width: 760px;

    margin: 30px 0 0;

    color: var(--color-muted);

    font-size: 20px;

    line-height: 1.8;
  }

  .technology-list {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin: 30px 0 0;

    padding: 0;

    list-style: none;
  }

  .technology-list li {
    padding: 8px 12px;

    border-radius: 8px;

    background: var(--color-subtle);

    color: var(--color-text-soft);

    font-size: 14px;

    font-weight: 700;
  }

  .project-button {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-top: 32px;

    padding: 12px 18px;

    border-radius: 10px;

    background: var(--color-accent);

    color: white;

    font-weight: 800;

    text-decoration: none;

    transition:
      transform 160ms ease,
      background 160ms ease;
  }

  .project-button:hover {
    background: var(--color-accent-hover);

    transform: translateY(-2px);
  }

  .unavailable {
    margin: 30px 0 0;

    color: var(--color-disabled);

    font-weight: 700;
  }

  .divider {
    height: 1px;

    margin: 64px 0;

    background: var(--color-border);
  }

  .case-study {
    max-width: 760px;

    color: var(--color-text);
  }

  .case-study :global(h2) {
    margin: 64px 0 20px;

    color: var(--color-text);

    font-size: clamp(28px, 4vw, 36px);

    line-height: 1.2;

    letter-spacing: -0.025em;
  }

  .case-study :global(h2:first-child) {
    margin-top: 0;
  }

  .case-study :global(h3) {
    margin: 40px 0 16px;

    color: var(--color-text);

    font-size: 23px;

    line-height: 1.3;
  }

  .case-study :global(p) {
    margin: 0 0 22px;

    color: var(--color-muted);

    font-size: 18px;

    line-height: 1.9;
  }

  .case-study :global(ul),
  .case-study :global(ol) {
    margin: 22px 0 28px;

    padding-left: 24px;

    color: var(--color-muted);

    font-size: 18px;

    line-height: 1.8;
  }

  .case-study :global(li) {
    margin-bottom: 8px;
  }

  .case-study :global(strong) {
    color: var(--color-text);

    font-weight: 800;
  }

  .case-study :global(a) {
    color: var(--color-accent);

    font-weight: 700;

    text-underline-offset: 4px;
  }

  .case-study :global(blockquote) {
    margin: 30px 0;

    padding: 4px 0 4px 22px;

    border-left: 4px solid var(--color-accent);

    color: var(--color-muted);
  }

  .case-study :global(code) {
    padding: 2px 6px;

    border-radius: 6px;

    background: var(--color-subtle);

    color: var(--color-text);

    font-size: 0.9em;
  }

  .case-study :global(pre) {
    overflow-x: auto;

    margin: 28px 0;

    padding: 20px;

    border: 1px solid var(--color-border);

    border-radius: 14px;

    background: var(--color-subtle);
  }

  .case-study :global(pre code) {
    padding: 0;

    background: transparent;
  }

  @media (max-width: 700px) {
    main {
      width: min(100% - 24px, 900px);

      padding: 40px 0 80px;
    }

    .back-link {
      margin-bottom: 40px;
    }

    .title-row {
      flex-direction: column;

      gap: 16px;
    }

    .status {
      margin-top: 0;
    }

    .description {
      font-size: 18px;
    }

    .divider {
      margin: 48px 0;
    }

    .case-study :global(h2) {
      margin-top: 48px;
    }

    .case-study :global(p),
    .case-study :global(ul),
    .case-study :global(ol) {
      font-size: 17px;
    }
  }
</style>
