---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";

import { createPageTitle } from "../lib/seo";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const statuses = [...new Set(projects.map((project) => project.data.status))];

const technologies = [
  ...new Set(projects.flatMap((project) => project.data.technologies)),
].sort((a, b) => a.localeCompare(b, "zh-CN"));
---

<BaseLayout
  title={createPageTitle("项目")}
  description="William 的前端学习项目展示"
>
  <Header />

  <main>
    <section class="page-heading">
      <p class="label">MY PROJECTS</p>

      <h1>项目展示</h1>

      <p class="intro">
        这里记录我在前端学习过程中完成的项目。
        每一个项目都对应一组具体的技术和实践目标。
      </p>
    </section>

    <section
      class="project-browser"
      data-project-browser
      aria-label="项目筛选和列表"
    >
      <div class="filter-panel" aria-label="项目筛选">
        <div class="filter-group">
          <p class="filter-label">项目状态</p>

          <div class="status-filters" aria-label="按项目状态筛选">
            <button
              class="filter-button is-active"
              type="button"
              data-status-filter="all"
              aria-pressed="true"
            >
              全部
            </button>

            {
              statuses.map((status) => (
                <button
                  class="filter-button"
                  type="button"
                  data-status-filter={status}
                  aria-pressed="false"
                >
                  {status}
                </button>
              ))
            }
          </div>
        </div>

        <div class="select-filters">
          <label class="select-field">
            <span> 技术 </span>

            <select data-technology-filter>
              <option value="all"> 全部技术 </option>

              {
                technologies.map((technology) => (
                  <option value={technology}>{technology}</option>
                ))
              }
            </select>
          </label>

          <label class="select-field">
            <span> 排序 </span>

            <select data-sort-filter>
              <option value="order"> 默认顺序 </option>

              <option value="title"> 按名称排序 </option>
            </select>
          </label>

          <button class="reset-button" type="button" data-reset-filters>
            重置筛选
          </button>
        </div>
      </div>

      <div class="result-summary">
        <p class="result-count" data-result-count aria-live="polite">
          显示 {projects.length} 个项目
        </p>
      </div>

      <section class="project-grid" data-project-grid aria-label="项目列表">
        {
          projects.map((project) => (
            <div
              class="project-item"
              data-project-item
              data-status={project.data.status}
              data-technologies={project.data.technologies.join("|||")}
              data-title={project.data.title}
              data-order={project.data.order}
            >
              <ProjectCard
                id={project.id}
                title={project.data.title}
                description={project.data.description}
                technologies={project.data.technologies}
                status={project.data.status}
                href={project.data.href}
              />
            </div>
          ))
        }
      </section>

      <div class="empty-state" data-empty-state hidden>
        <h2>没有找到符合条件的项目</h2>

        <p>尝试更换项目状态或技术筛选条件。</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  function initProjectFilters() {
    const browser = document.querySelector("[data-project-browser]");

    if (!(browser instanceof HTMLElement)) {
      return;
    }

    if (browser.dataset.initialized === "true") {
      return;
    }

    browser.dataset.initialized = "true";

    const grid = browser.querySelector("[data-project-grid]");

    const technologySelect = browser.querySelector("[data-technology-filter]");

    const sortSelect = browser.querySelector("[data-sort-filter]");

    const resetButton = browser.querySelector("[data-reset-filters]");

    const resultCount = browser.querySelector("[data-result-count]");

    const emptyState = browser.querySelector("[data-empty-state]");

    const statusButtons = [...browser.querySelectorAll("[data-status-filter]")];

    const items = [...browser.querySelectorAll("[data-project-item]")];

    if (
      !(grid instanceof HTMLElement) ||
      !(technologySelect instanceof HTMLSelectElement) ||
      !(sortSelect instanceof HTMLSelectElement)
    ) {
      return;
    }

    let activeStatus = "all";

    const applyFilters = () => {
      const selectedTechnology = technologySelect.value;

      for (const item of items) {
        if (!(item instanceof HTMLElement)) {
          continue;
        }

        const status = item.dataset.status ?? "";

        const technologies = (item.dataset.technologies ?? "")
          .split("|||")
          .filter(Boolean);

        const matchesStatus = activeStatus === "all" || status === activeStatus;

        const matchesTechnology =
          selectedTechnology === "all" ||
          technologies.includes(selectedTechnology);

        item.hidden = !(matchesStatus && matchesTechnology);
      }

      const sortedItems = [...items].sort((a, b) => {
        if (!(a instanceof HTMLElement && b instanceof HTMLElement)) {
          return 0;
        }

        if (sortSelect.value === "title") {
          return (a.dataset.title ?? "").localeCompare(
            b.dataset.title ?? "",
            "zh-CN",
          );
        }

        return Number(a.dataset.order ?? 0) - Number(b.dataset.order ?? 0);
      });

      for (const item of sortedItems) {
        grid.append(item);
      }

      const visibleCount = items.filter(
        (item) => item instanceof HTMLElement && !item.hidden,
      ).length;

      if (resultCount) {
        resultCount.textContent = `显示 ${visibleCount} 个项目`;
      }

      if (emptyState instanceof HTMLElement) {
        emptyState.hidden = visibleCount !== 0;
      }
    };

    for (const button of statusButtons) {
      if (!(button instanceof HTMLButtonElement)) {
        continue;
      }

      button.addEventListener("click", () => {
        activeStatus = button.dataset.statusFilter ?? "all";

        for (const otherButton of statusButtons) {
          if (!(otherButton instanceof HTMLButtonElement)) {
            continue;
          }

          const isActive = otherButton === button;

          otherButton.classList.toggle("is-active", isActive);

          otherButton.setAttribute("aria-pressed", String(isActive));
        }

        applyFilters();
      });
    }

    technologySelect.addEventListener("change", applyFilters);

    sortSelect.addEventListener("change", applyFilters);

    if (resetButton instanceof HTMLButtonElement) {
      resetButton.addEventListener("click", () => {
        activeStatus = "all";

        technologySelect.value = "all";

        sortSelect.value = "order";

        for (const button of statusButtons) {
          if (!(button instanceof HTMLButtonElement)) {
            continue;
          }

          const isActive = button.dataset.statusFilter === "all";

          button.classList.toggle("is-active", isActive);

          button.setAttribute("aria-pressed", String(isActive));
        }

        applyFilters();
      });
    }

    applyFilters();
  }

  initProjectFilters();

  document.addEventListener("astro:page-load", initProjectFilters);
</script>

<style>
  main {
    width: min(1100px, calc(100% - 40px));

    margin: 0 auto;

    padding: 80px 0 100px;
  }

  .page-heading {
    max-width: 760px;
  }

  .label {
    margin: 0;

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  h1 {
    margin: 14px 0 22px;

    color: var(--color-text);

    font-size: clamp(48px, 8vw, 78px);

    line-height: 1.05;

    letter-spacing: -0.055em;
  }

  .intro {
    margin: 0;

    color: var(--color-muted);

    font-size: 20px;

    line-height: 1.8;
  }

  .project-browser {
    margin-top: 54px;
  }

  .filter-panel {
    padding: 24px;

    border: 1px solid var(--color-border);

    border-radius: 18px;

    background: var(--color-surface);

    box-shadow: var(--shadow-card);
  }

  .filter-group {
    display: flex;

    align-items: center;

    gap: 22px;

    min-width: 0;
  }

  .filter-label {
    flex-shrink: 0;

    margin: 0;

    color: var(--color-text);

    font-size: 14px;

    font-weight: 800;
  }

  .status-filters {
    display: flex;

    flex-wrap: wrap;

    gap: 9px;
  }

  .filter-button {
    padding: 8px 13px;

    border: 1px solid var(--color-border);

    border-radius: 999px;

    background: var(--color-surface-soft);

    color: var(--color-text-soft);

    font-size: 13px;

    font-weight: 700;

    cursor: pointer;

    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .filter-button:hover {
    border-color: var(--color-accent);

    color: var(--color-accent);
  }

  .filter-button.is-active {
    border-color: var(--color-accent);

    background: var(--color-accent);

    color: var(--color-on-accent);
  }

  .select-filters {
    display: flex;

    align-items: flex-end;

    flex-wrap: wrap;

    gap: 14px;

    margin-top: 22px;

    padding-top: 22px;

    border-top: 1px solid var(--color-border);
  }

  .select-field {
    display: grid;

    gap: 7px;
  }

  .select-field span {
    color: var(--color-muted);

    font-size: 12px;

    font-weight: 800;
  }

  .select-field select {
    min-width: 170px;

    height: 42px;

    padding: 0 36px 0 12px;

    border: 1px solid var(--color-border);

    border-radius: 10px;

    background: var(--color-surface-soft);

    color: var(--color-text);

    cursor: pointer;
  }

  .reset-button {
    height: 42px;

    padding: 0 14px;

    border: 0;

    background: transparent;

    color: var(--color-accent);

    font-weight: 800;

    cursor: pointer;
  }

  .reset-button:hover {
    text-decoration: underline;

    text-underline-offset: 4px;
  }

  .result-summary {
    display: flex;

    align-items: center;

    min-height: 48px;
  }

  .result-count {
    margin: 0;

    color: var(--color-muted);

    font-size: 14px;

    font-weight: 700;
  }

  .project-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    align-items: stretch;

    gap: 24px;
  }

  .project-item {
    display: flex;

    min-width: 0;
  }

  .project-item[hidden] {
    display: none;
  }

  .project-item > :global(article) {
    width: 100%;
  }

  .empty-state {
    padding: 56px 24px;

    border: 1px dashed var(--color-border);

    border-radius: 18px;

    text-align: center;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-state h2 {
    margin: 0;

    color: var(--color-text);

    font-size: 24px;
  }

  .empty-state p {
    margin: 12px 0 0;

    color: var(--color-muted);
  }

  @media (max-width: 1000px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    main {
      width: min(100% - 24px, 1100px);

      padding-top: 50px;
    }

    .project-browser {
      margin-top: 42px;
    }

    .filter-panel {
      padding: 18px;
    }

    .filter-group {
      align-items: flex-start;

      flex-direction: column;

      gap: 12px;
    }

    .select-filters {
      align-items: stretch;

      flex-direction: column;
    }

    .select-field {
      width: 100%;
    }

    .select-field select {
      width: 100%;

      min-width: 0;
    }

    .reset-button {
      align-self: flex-start;

      padding-left: 0;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
