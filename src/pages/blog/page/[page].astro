---
import type { GetStaticPaths } from "astro";

import BaseLayout from "../../../layouts/BaseLayout.astro";

import Header from "../../../components/Header.astro";

import BlogCard from "../../../components/BlogCard.astro";

import BlogPagination from "../../../components/BlogPagination.astro";

import { pageDescriptions } from "../../../config/site";

import {
  getBlogAdditionalPageNumbers,
  getBlogPageData,
  getPublishedBlogPosts,
  type BlogPageData,
} from "../../../lib/blog";

import { createPageTitle } from "../../../lib/seo";

interface Props {
  page: BlogPageData;
}

export const getStaticPaths = (async () => {
  const posts = await getPublishedBlogPosts();

  const pageNumbers = getBlogAdditionalPageNumbers(posts.length);

  return pageNumbers.map((pageNumber) => ({
    params: {
      page: String(pageNumber),
    },

    props: {
      page: getBlogPageData(posts, pageNumber),
    },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const pageTitle = createPageTitle(`博客 - 第 ${page.currentPage} 页`);

const pageDescription = `${pageDescriptions.blog} 第 ${page.currentPage} 页。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content" tabindex="-1" class="blog-page">
    <section class="page-heading">
      <p class="label">LEARNING NOTES</p>

      <h1>博客文章</h1>

      <p class="intro">
        第 {page.currentPage} 页，共 {page.totalPages} 页。
      </p>
    </section>

    <section
      class="blog-grid"
      aria-label={`博客文章列表，第 ${page.currentPage} 页`}
    >
      {
        page.posts.map((post) => (
          <div class="post-item">
            <BlogCard post={post} />
          </div>
        ))
      }
    </section>
    <BlogPagination page={page} />
  </main>
</BaseLayout>

<style>
  .blog-page {
    width: min(1100px, calc(100% - 40px));

    margin: 0 auto;

    padding: 80px 0 100px;
  }

  .page-heading {
    max-width: 760px;
  }

  .label {
    margin: 0;

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  h1 {
    margin: 14px 0 22px;

    font-size: clamp(48px, 8vw, 78px);

    line-height: 1.05;

    letter-spacing: -0.055em;
  }

  .intro {
    margin: 0;

    color: var(--color-muted);

    font-size: 20px;

    line-height: 1.8;
  }

  .blog-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 24px;

    margin-top: 52px;
  }

  .post-item {
    min-width: 0;

    height: 100%;
  }

  @media (max-width: 760px) {
    .blog-page {
      width: min(100% - 24px, 1100px);

      padding-top: 50px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
