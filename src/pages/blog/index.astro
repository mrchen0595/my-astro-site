---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Header from "../../components/Header.astro";

import BlogCard from "../../components/BlogCard.astro";

import BlogDiscovery from "../../components/BlogDiscovery.astro";

import BlogPagination from "../../components/BlogPagination.astro";

import { pageDescriptions } from "../../config/site";

import { getBlogIndexData, getBlogPageData } from "../../lib/blog";

import { createPageTitle } from "../../lib/seo";

const { posts: allPosts, tags } = await getBlogIndexData();

const page = getBlogPageData(allPosts, 1);

const posts = page.posts;
---

<BaseLayout title={createPageTitle("博客")} description={pageDescriptions.blog}>
  <Header />

  <main id="main-content" tabindex="-1" class="blog-page">
    <section class="page-heading">
      <p class="label">LEARNING NOTES</p>

      <h1>博客文章</h1>

      <p class="intro">这里记录我的前端开发学习过程、 技术实践和项目总结。</p>

      <a class="rss-link" href="/rss.xml">
        订阅博客 RSS

        <span aria-hidden="true"> → </span>
      </a>
    </section>

    {
      posts.length > 0 ? (
        <>
          <BlogDiscovery tags={tags} total={allPosts.length} />

          <section
            id="blog-results"
            class="blog-grid"
            aria-label="博客文章列表"
          >
            {posts.map((post) => (
              <div class="post-item">
                <BlogCard post={post} />
              </div>
            ))}
          </section>
          <BlogPagination page={page} />
        </>
      ) : (
        <p class="empty-message">目前还没有已发布的文章。</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .blog-page {
    width: min(1100px, calc(100% - 40px));

    margin: 0 auto;

    padding: 80px 0 100px;
  }

  .page-heading {
    max-width: 760px;
  }

  .label {
    margin: 0;

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  h1 {
    margin: 14px 0 22px;

    font-size: clamp(48px, 8vw, 78px);

    line-height: 1.05;

    letter-spacing: -0.055em;
  }

  .intro {
    margin: 0;

    color: var(--color-muted);

    font-size: 20px;

    line-height: 1.8;
  }

  .rss-link {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-top: 22px;

    color: var(--color-accent);

    font-weight: 800;

    text-decoration: none;
  }

  .rss-link:hover {
    text-decoration: underline;
  }

  .blog-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 24px;

    margin-top: 34px;
  }

  .post-item {
    min-width: 0;

    height: 100%;
  }

  .empty-message {
    margin-top: 60px;

    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .blog-page {
      width: min(100% - 24px, 1100px);

      padding-top: 50px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
