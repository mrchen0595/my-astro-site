---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Header from "../../components/Header.astro";

import BlogCard from "../../components/BlogCard.astro";

import BlogFilters from "../../components/BlogFilters.astro";

import { pageDescriptions } from "../../config/site";

import { getBlogIndexData } from "../../lib/blog";

import { createPageTitle } from "../../lib/seo";

const { posts, tags } = await getBlogIndexData();
---

<BaseLayout title={createPageTitle("博客")} description={pageDescriptions.blog}>
  <Header />

  <main class="blog-page">
    <section class="page-heading">
      <p class="label">LEARNING NOTES</p>

      <h1>博客文章</h1>

      <p class="intro">这里记录我的前端开发学习过程、 技术实践和项目总结。</p>

      <a class="rss-link" href="/rss.xml">
        订阅博客 RSS

        <span aria-hidden="true"> → </span>
      </a>
    </section>

    {
      posts.length > 0 ? (
        <>
          <BlogFilters tags={tags} total={posts.length} />

          <section
            id="blog-results"
            class="blog-grid"
            aria-label="博客文章列表"
          >
            {posts.map((post) => (
              <div
                class="post-item"
                data-blog-item
                data-title={post.data.title}
                data-description={post.data.description}
                data-tags={JSON.stringify(post.data.tags)}
              >
                <BlogCard post={post} />
              </div>
            ))}
          </section>

          <section id="blog-empty-message" class="empty-state" hidden>
            <h2>没有找到相关文章</h2>

            <p>尝试更换关键词， 或选择其他标签。</p>
          </section>
        </>
      ) : (
        <p class="empty-message">目前还没有已发布的文章。</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .blog-page {
    width: min(1100px, calc(100% - 40px));

    margin: 0 auto;

    padding: 80px 0 100px;
  }

  .page-heading {
    max-width: 760px;
  }

  .label {
    margin: 0;

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  h1 {
    margin: 14px 0 22px;

    font-size: clamp(48px, 8vw, 78px);

    line-height: 1.05;

    letter-spacing: -0.055em;
  }

  .intro {
    margin: 0;

    color: var(--color-muted);

    font-size: 20px;

    line-height: 1.8;
  }

  .rss-link {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-top: 22px;

    color: var(--color-accent);

    font-weight: 800;

    text-decoration: none;
  }

  .rss-link:hover {
    text-decoration: underline;
  }

  .blog-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 24px;

    margin-top: 34px;
  }

  .post-item {
    min-width: 0;

    height: 100%;
  }

  .post-item[hidden] {
    display: none;
  }

  .empty-state {
    margin-top: 34px;

    padding: 48px 24px;

    border: 1px dashed var(--color-border);

    border-radius: 20px;

    text-align: center;
  }

  .empty-state h2 {
    margin: 0;

    font-size: 25px;
  }

  .empty-state p {
    margin: 12px 0 0;

    color: var(--color-muted);
  }

  .empty-message {
    margin-top: 60px;

    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .blog-page {
      width: min(100% - 24px, 1100px);

      padding-top: 50px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
