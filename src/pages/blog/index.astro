---
import {
  getCollection,
} from "astro:content";

import BaseLayout from
  "../../layouts/BaseLayout.astro";

import Header from
  "../../components/Header.astro";

import BlogCard from
  "../../components/BlogCard.astro";

const posts = (
  await getCollection(
    "blog",
    ({ data }) =>
      data.draft !== true
  )
).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="博客 | William 的网站"
  description="William 的 Astro 和前端学习记录"
>
  <Header />

  <main class="blog-page">
    <section class="page-heading">
      <p class="label">
        LEARNING NOTES
      </p>

      <h1>博客文章</h1>

      <p class="intro">
        这里记录我的前端开发学习过程、
        技术实践和项目总结。
      </p>
      <a
        class="rss-link"
        href="/rss.xml"
      >
        订阅博客 RSS
        <span aria-hidden="true">→</span>
      </a>
    </section>

    {
      posts.length > 0 ? (
        <section
          class="blog-grid"
          aria-label="博客文章列表"
        >
          {
            posts.map((post) => (
              <BlogCard post={post} />
            ))
          }
        </section>
      ) : (
        <p class="empty-message">
          目前还没有已发布的文章。
        </p>
      )
    }
  </main>
</BaseLayout>

<style>
.rss-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 22px;
  color: #5145cd;
  font-weight: 800;
  text-decoration: none;
}

.rss-link:hover {
  text-decoration: underline;
}

  .blog-page {
    width: min(
      1000px,
      calc(100% - 40px)
    );
    margin: 0 auto;
    padding: 80px 0 100px;
  }

  .page-heading {
    max-width: 760px;
  }

  .label {
    margin: 0;
    color: #5145cd;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 14px 0 22px;
    font-size: clamp(
      48px,
      8vw,
      78px
    );
    line-height: 1.05;
    letter-spacing: -0.055em;
  }

  .intro {
    margin: 0;
    color: #676c78;
    font-size: 20px;
    line-height: 1.8;
  }

  .blog-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 64px;
  }

  .empty-message {
    margin-top: 60px;
    color: #676c78;
  }

  @media (max-width: 700px) {
    .blog-page {
      width: min(
        100% - 24px,
        1000px
      );
      padding-top: 50px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      margin-top: 44px;
    }
  }
</style>