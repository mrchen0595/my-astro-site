---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import BaseLayout from
  "../../layouts/BaseLayout.astro";

import Header from
  "../../components/Header.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts =
    await getCollection(
      "blog",
      ({ data }) =>
        data.draft !== true
    );

  return posts.map((post) => ({
    params: {
      id: post.id,
    },

    props: {
      post,
    },
  }));
}

const { post } = Astro.props;

const { Content } =
  await render(post);

const formattedDate =
  new Intl.DateTimeFormat(
    "zh-CN",
    {
      year: "numeric",
      month: "long",
      day: "numeric",
    }
  ).format(post.data.pubDate);
---

<BaseLayout
  title={`${post.data.title} | William 的网站`}
  description={post.data.description}
>
  <Header />

  <main class="article-page">
    <article class="article-shell">
      <a
        class="back-link"
        href="/blog"
      >
        ← 返回博客
      </a>

      <header class="article-header">
        <p class="date">
          {formattedDate}
        </p>

        <h1>
          {post.data.title}
        </h1>

        <p class="description">
          {post.data.description}
        </p>

        {
          post.data.tags.length > 0 && (
            <ul
              class="tag-list"
              aria-label="文章标签"
            >
              {
                post.data.tags.map(
                  (tag) => (
                    <li>{tag}</li>
                  )
                )
              }
            </ul>
          )
        }
      </header>

      <div class="article-content">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .article-page {
    width: min(
      820px,
      calc(100% - 40px)
    );
    margin: 0 auto;
    padding: 70px 0 110px;
  }

  .article-shell {
    padding: 46px;
    border: 1px solid #dfe2ea;
    border-radius: 24px;
    background: white;
    box-shadow:
      0 18px 55px
      rgba(30, 35, 70, 0.07);
  }

  .back-link {
    color: #5145cd;
    font-weight: 800;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-header {
    margin-top: 44px;
    padding-bottom: 36px;
    border-bottom: 1px solid #e5e7eb;
  }

  .article-header .date {
    margin: 0;
    color: #777d89;
    font-size: 14px;
  }

  .article-header h1 {
    margin: 15px 0 20px;
    font-size: clamp(
      40px,
      7vw,
      64px
    );
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .article-header .description {
    margin: 0;
    color: #676c78;
    font-size: 19px;
    line-height: 1.8;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 7px 10px;
    border-radius: 8px;
    background: #f0efff;
    color: #5145cd;
    font-size: 13px;
    font-weight: 800;
  }

  .article-content {
    margin-top: 42px;
    color: #30343b;
    font-size: 17px;
    line-height: 1.9;
  }

  .article-content h2 {
    margin: 48px 0 18px;
    font-size: 30px;
    line-height: 1.3;
  }

  .article-content h3 {
    margin: 36px 0 16px;
    font-size: 23px;
  }

  .article-content p {
    margin: 20px 0;
  }

  .article-content ul,
  .article-content ol {
    padding-left: 26px;
  }

  .article-content li {
    margin: 10px 0;
  }

  .article-content pre {
    overflow-x: auto;
    margin: 26px 0;
    padding: 20px;
    border-radius: 14px;
    background: #181a20;
    color: #f5f7fa;
  }

  .article-content code {
    font-family:
      Consolas,
      "Courier New",
      monospace;
  }

  .article-content :not(pre) > code {
    padding: 3px 6px;
    border-radius: 6px;
    background: #f0efff;
    color: #5145cd;
  }

  .article-content blockquote {
    margin: 26px 0;
    padding: 4px 0 4px 20px;
    border-left: 4px solid #5145cd;
    color: #5f6470;
  }

  @media (max-width: 600px) {
    .article-page {
      width: min(
        100% - 20px,
        820px
      );
      padding-top: 30px;
    }

    .article-shell {
      padding: 26px 20px;
    }
  }
</style>