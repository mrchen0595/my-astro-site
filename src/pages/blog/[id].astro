---
import { getCollection, render, type CollectionEntry } from "astro:content";

import { getImage } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";

import Header from "../../components/Header.astro";

import BlogCover from "../../components/BlogCover.astro";

import StructuredData from "../../components/StructuredData.astro";

import Breadcrumbs from "../../components/Breadcrumbs.astro";

import { createPageTitle } from "../../lib/seo";

import { createBlogPostingStructuredData } from "../../lib/structured-data";

import { createSiteUrl, getBaseUrl } from "../../lib/url";

interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true);

  return posts.map((post) => ({
    params: {
      id: post.id,
    },

    props: {
      post,
    },
  }));
}

const { post } = Astro.props;

const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.pubDate);

const baseURL = getBaseUrl(Astro.site, Astro.url.origin);

const articleURL = createSiteUrl(`/blog/${post.id}`, baseURL);

const authorURL = createSiteUrl("/about", baseURL);

const structuredImage = await getImage({
  src: post.data.cover,

  width: 1200,

  height: 630,

  format: "jpg",

  fit: "cover",
});

const structuredImageURL = createSiteUrl(structuredImage.src, baseURL);

const blogPostingStructuredData = createBlogPostingStructuredData({
  title: post.data.title,

  description: post.data.description,

  pageUrl: articleURL,

  imageUrl: structuredImageURL,

  datePublished: post.data.pubDate,

  dateModified: post.data.updatedDate,

  authorUrl: authorURL,
});

const breadcrumbItems = [
  {
    name: "首页",
    href: "/",
  },

  {
    name: "博客",
    href: "/blog",
  },

  {
    name: post.data.title,
  },
];
---

<BaseLayout
  title={createPageTitle(post.data.title)}
  description={post.data.description}
  pageType="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
  image={post.data.cover}
  imageAlt={post.data.coverAlt}
>
  <StructuredData data={blogPostingStructuredData} />

  <Header />

  <main class="article-page">
    <Breadcrumbs items={breadcrumbItems} />

    <article class="article-shell">
      <a class="back-link" href="/blog"> ← 返回博客 </a>

      <header class="article-header">
        <p class="date">
          {formattedDate}
        </p>

        <h1>
          {post.data.title}
        </h1>

        <p class="description">
          {post.data.description}
        </p>

        {
          post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="文章标签">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      <figure class="article-cover">
        <BlogCover
          src={post.data.cover}
          alt={post.data.coverAlt}
          variant="article"
          eager={true}
        />
      </figure>

      <div class="article-content">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .article-cover {
    margin: 36px 0 0;

    overflow: hidden;

    border-radius: 18px;

    background: var(--color-subtle);
  }

  .article-cover img {
    display: block;

    width: 100%;
  }

  .article-page {
    width: min(820px, calc(100% - 40px));

    margin: 0 auto;

    padding: 70px 0 110px;
  }

  .article-shell {
    padding: 46px;

    border: 1px solid var(--color-border);

    border-radius: 24px;

    background: var(--color-surface);

    box-shadow: 0 18px 55px rgba(30, 35, 70, 0.07);
  }

  .back-link {
    color: var(--color-accent);

    font-weight: 800;

    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-header {
    margin-top: 44px;

    padding-bottom: 36px;

    border-bottom: 1px solid var(--color-border);
  }

  .article-header .date {
    margin: 0;

    color: var(--color-muted);

    font-size: 14px;
  }

  .article-header h1 {
    margin: 15px 0 20px;

    font-size: clamp(40px, 7vw, 64px);

    line-height: 1.08;

    letter-spacing: -0.045em;
  }

  .article-header .description {
    margin: 0;

    color: var(--color-muted);

    font-size: 19px;

    line-height: 1.8;
  }

  .tag-list {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin: 24px 0 0;

    padding: 0;

    list-style: none;
  }

  .tag-list li {
    padding: 7px 10px;

    border-radius: 8px;

    background: var(--color-accent-soft);

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;
  }

  .article-content {
    margin-top: 42px;

    color: var(--color-text-soft);

    font-size: 17px;

    line-height: 1.9;
  }

  .article-content h2 {
    margin: 48px 0 18px;

    font-size: 30px;

    line-height: 1.3;
  }

  .article-content h3 {
    margin: 36px 0 16px;

    font-size: 23px;
  }

  .article-content p {
    margin: 20px 0;
  }

  .article-content ul,
  .article-content ol {
    padding-left: 26px;
  }

  .article-content li {
    margin: 10px 0;
  }

  .article-content pre {
    overflow-x: auto;

    margin: 26px 0;

    padding: 20px;

    border-radius: 14px;

    background: var(--color-code-bg);

    color: var(--color-code-text);
  }

  .article-content code {
    font-family: Consolas, "Courier New", monospace;
  }

  .article-content :not(pre) > code {
    padding: 3px 6px;

    border-radius: 6px;

    background: var(--color-accent-soft);

    color: var(--color-accent);
  }

  .article-content blockquote {
    margin: 26px 0;

    padding: 4px 0 4px 20px;

    border-left: 4px solid var(--color-accent);

    color: var(--color-text-soft);
  }

  @media (max-width: 600px) {
    .article-page {
      width: min(100% - 20px, 820px);

      padding-top: 30px;
    }

    .article-shell {
      padding: 26px 20px;
    }
  }
</style>
