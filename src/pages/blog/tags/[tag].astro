---
import type { GetStaticPaths } from "astro";

import BaseLayout from "../../../layouts/BaseLayout.astro";

import Header from "../../../components/Header.astro";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";

import BlogCard from "../../../components/BlogCard.astro";

import {
  getBlogPostsByTag,
  getBlogTagRouteItems,
  getPublishedBlogPosts,
  type BlogEntry,
  type BlogTagRouteItem,
} from "../../../lib/blog";

import { createPageTitle } from "../../../lib/seo";

interface Props {
  tag: BlogTagRouteItem;
  posts: BlogEntry[];
}

export const getStaticPaths = (async () => {
  const posts = await getPublishedBlogPosts();

  const tags = getBlogTagRouteItems(posts);

  return tags.map((tag) => ({
    params: {
      tag: tag.slug,
    },

    props: {
      tag,
      posts: getBlogPostsByTag(posts, tag.name),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;

const pageTitle = createPageTitle(`${tag.name} 标签`);

const pageDescription = `查看 William 关于 ${tag.name} 的博客文章和前端学习记录。`;

const breadcrumbItems = [
  {
    name: "首页",
    href: "/",
  },

  {
    name: "博客",
    href: "/blog",
  },

  {
    name: tag.name,
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content" tabindex="-1" class="tag-page">
    <Breadcrumbs items={breadcrumbItems} />

    <section class="page-heading">
      <p class="label">BLOG TAG</p>

      <h1>{tag.name}</h1>

      <p class="intro">
        标签“{tag.name}”下共有 {tag.count} 篇文章。
      </p>

      <a class="back-link" href="/blog"> ← 返回全部博客 </a>
    </section>

    <section class="blog-grid" aria-label={`${tag.name} 标签文章列表`}>
      {
        posts.map((post) => (
          <div class="post-item">
            <BlogCard post={post} />
          </div>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .tag-page {
    width: min(1100px, calc(100% - 40px));

    margin: 0 auto;

    padding: 80px 0 100px;
  }

  .page-heading {
    max-width: 760px;
  }

  .label {
    margin: 0;

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  h1 {
    margin: 14px 0 22px;

    font-size: clamp(48px, 8vw, 78px);

    line-height: 1.05;

    letter-spacing: -0.055em;
  }

  .intro {
    margin: 0;

    color: var(--color-muted);

    font-size: 20px;

    line-height: 1.8;
  }

  .back-link {
    display: inline-block;

    margin-top: 22px;

    color: var(--color-accent);

    font-weight: 800;

    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .blog-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 24px;

    margin-top: 52px;
  }

  .post-item {
    min-width: 0;

    height: 100%;
  }

  @media (max-width: 760px) {
    .tag-page {
      width: min(100% - 24px, 1100px);

      padding-top: 50px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
