---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

import { createPageTitle } from "../lib/seo";

import { getSearchIndex } from "../lib/search";

const searchIndex = await getSearchIndex();

const serializedSearchIndex = JSON.stringify(searchIndex);
---

<BaseLayout
  title={createPageTitle("搜索")}
  description="搜索博客文章和项目案例"
>
  <Header />

  <main class="search-page">
    <section class="search-header">
      <p class="eyebrow">SEARCH</p>

      <h1>站内搜索</h1>

      <p class="intro">搜索博客文章、项目案例、技术标签和关键词。</p>
    </section>

    <section
      class="search-panel"
      data-search-app
      data-search-index={serializedSearchIndex}
    >
      <div class="search-controls">
        <div class="search-field">
          <label for="search-input"> 搜索内容 </label>

          <input
            id="search-input"
            type="search"
            name="q"
            placeholder="例如：Astro、JavaScript、CSS"
            autocomplete="off"
          />
        </div>

        <div class="type-field">
          <label for="search-type"> 内容类型 </label>

          <select id="search-type" name="type">
            <option value="all"> 全部 </option>

            <option value="blog"> 博客 </option>

            <option value="project"> 项目 </option>
          </select>
        </div>
      </div>

      <p class="search-summary" data-search-summary aria-live="polite">
        输入关键词开始搜索。
      </p>

      <div class="search-results" data-search-results></div>

      <div class="empty-state" data-search-empty>
        <strong> 开始搜索 </strong>

        <p>可以搜索标题、简介、博客标签、项目技术和项目状态。</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    searchItems,
    type SearchItem,
    type SearchItemType,
  } from "../lib/search-core";

  function getRequiredElement<T extends Element>(
    root: ParentNode,
    selector: string,
  ): T {
    const element = root.querySelector<T>(selector);

    if (!element) {
      throw new Error(`找不到必要的页面元素：${selector}`);
    }

    return element;
  }

  function initSearch() {
    const app = document.querySelector<HTMLElement>("[data-search-app]");

    if (!app) {
      return;
    }

    const input = getRequiredElement<HTMLInputElement>(app, "#search-input");

    const typeSelect = getRequiredElement<HTMLSelectElement>(
      app,
      "#search-type",
    );

    const summary = getRequiredElement<HTMLElement>(
      app,
      "[data-search-summary]",
    );

    const resultsContainer = getRequiredElement<HTMLElement>(
      app,
      "[data-search-results]",
    );

    const emptyState = getRequiredElement<HTMLElement>(
      app,
      "[data-search-empty]",
    );

    const emptyTitle = getRequiredElement<HTMLElement>(emptyState, "strong");

    const emptyDescription = getRequiredElement<HTMLParagraphElement>(
      emptyState,
      "p",
    );

    const searchIndex = JSON.parse(
      app.dataset.searchIndex ?? "[]",
    ) as SearchItem[];

    function getTypeLabel(type: SearchItemType): string {
      return type === "blog" ? "博客" : "项目";
    }

    function createResultCard(item: SearchItem): HTMLElement {
      const article = document.createElement("article");

      article.className = "search-result";

      article.dataset.searchResult = "";

      article.dataset.type = item.type;

      const top = document.createElement("div");

      top.className = "result-top";

      const type = document.createElement("span");

      type.className = "result-type";

      type.textContent = getTypeLabel(item.type);

      const title = document.createElement("h2");

      const link = document.createElement("a");

      link.href = item.href;

      link.textContent = item.title;

      title.append(link);

      top.append(type, title);

      const description = document.createElement("p");

      description.className = "result-description";

      description.textContent = item.description;

      article.append(top, description);

      if (item.keywords.length > 0) {
        const keywordList = document.createElement("ul");

        keywordList.className = "keyword-list";

        keywordList.setAttribute("aria-label", `${item.title} 的关键词`);

        for (const keyword of item.keywords.slice(0, 5)) {
          const keywordItem = document.createElement("li");

          keywordItem.textContent = keyword;

          keywordList.append(keywordItem);
        }

        article.append(keywordList);
      }

      return article;
    }

    function updateUrl(query: string, type: string) {
      const params = new URLSearchParams(window.location.search);

      if (query) {
        params.set("q", query);
      } else {
        params.delete("q");
      }

      if (type !== "all") {
        params.set("type", type);
      } else {
        params.delete("type");
      }

      const queryString = params.toString();

      const nextUrl = queryString
        ? `${window.location.pathname}?${queryString}`
        : window.location.pathname;

      window.history.replaceState(null, "", nextUrl);
    }

    function showInitialState() {
      summary.textContent = "输入关键词开始搜索。";

      emptyTitle.textContent = "开始搜索";

      emptyDescription.textContent =
        "可以搜索标题、简介、博客标签、项目技术和项目状态。";

      emptyState.hidden = false;
    }

    function showEmptyState(query: string) {
      summary.textContent = "找到 0 个结果";

      emptyTitle.textContent = "没有找到结果";

      emptyDescription.textContent = `没有与“${query}”匹配的内容。`;

      emptyState.hidden = false;
    }

    function renderSearch() {
      const query = input.value.trim();

      const selectedType = typeSelect.value;

      resultsContainer.replaceChildren();

      updateUrl(query, selectedType);

      if (!query) {
        showInitialState();

        return;
      }

      let results = searchItems(searchIndex, query);

      if (selectedType !== "all") {
        results = results.filter((item) => item.type === selectedType);
      }

      if (results.length === 0) {
        showEmptyState(query);

        return;
      }

      summary.textContent = `找到 ${results.length} 个结果`;

      emptyState.hidden = true;

      const cards = results.map(createResultCard);

      resultsContainer.append(...cards);
    }

    const initialParams = new URLSearchParams(window.location.search);

    const initialQuery = initialParams.get("q");

    const initialType = initialParams.get("type");

    if (initialQuery) {
      input.value = initialQuery;
    }

    if (initialType === "blog" || initialType === "project") {
      typeSelect.value = initialType;
    }

    input.addEventListener("input", renderSearch);

    typeSelect.addEventListener("change", renderSearch);

    renderSearch();
  }

  initSearch();
</script>

<style>
  .search-page {
    width: min(900px, calc(100% - 40px));

    margin: 0 auto;

    padding: 72px 0 110px;
  }

  .search-header {
    max-width: 720px;
  }

  .eyebrow {
    margin: 0;

    color: var(--color-accent);

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  h1 {
    margin: 14px 0 18px;

    font-size: clamp(44px, 8vw, 72px);

    line-height: 1.05;

    letter-spacing: -0.05em;
  }

  .intro {
    margin: 0;

    color: var(--color-muted);

    font-size: 19px;

    line-height: 1.8;
  }

  .search-panel {
    margin-top: 48px;
  }

  .search-controls {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      180px;

    gap: 16px;
  }

  .search-field,
  .type-field {
    display: flex;

    flex-direction: column;

    gap: 8px;
  }

  label {
    color: var(--color-text);

    font-size: 14px;

    font-weight: 800;
  }

  input,
  select {
    width: 100%;

    min-height: 48px;

    padding: 0 14px;

    border: 1px solid var(--color-border);

    border-radius: 10px;

    background: var(--color-surface);

    color: var(--color-text);

    font: inherit;
  }

  input:focus,
  select:focus {
    outline: 2px solid var(--color-accent);

    outline-offset: 2px;
  }

  .search-summary {
    margin: 28px 0 18px;

    color: var(--color-muted);

    font-size: 14px;

    font-weight: 700;
  }

  .search-results {
    display: grid;

    gap: 14px;
  }

  .search-result {
    padding: 24px;

    border: 1px solid var(--color-border);

    border-radius: 16px;

    background: var(--color-surface);
  }

  .result-top {
    display: flex;

    align-items: flex-start;

    gap: 14px;
  }

  .result-type {
    flex-shrink: 0;

    margin-top: 5px;

    padding: 5px 8px;

    border-radius: 7px;

    background: var(--color-accent-soft);

    color: var(--color-accent);

    font-size: 12px;

    font-weight: 800;
  }

  .result-top h2 {
    margin: 0;

    font-size: 22px;

    line-height: 1.35;
  }

  .result-top a {
    color: var(--color-text);

    text-decoration: none;
  }

  .result-top a:hover {
    color: var(--color-accent);
  }

  .result-description {
    margin: 14px 0 0;

    color: var(--color-muted);

    line-height: 1.7;
  }

  .keyword-list {
    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin: 16px 0 0;

    padding: 0;

    list-style: none;
  }

  .keyword-list li {
    padding: 5px 8px;

    border-radius: 7px;

    background: var(--color-subtle);

    color: var(--color-text-soft);

    font-size: 12px;

    font-weight: 700;
  }

  .empty-state {
    padding: 40px 24px;

    border: 1px dashed var(--color-border);

    border-radius: 16px;

    text-align: center;
  }

  .empty-state strong {
    display: block;

    font-size: 18px;
  }

  .empty-state p {
    margin: 8px 0 0;

    color: var(--color-muted);

    line-height: 1.7;
  }

  .empty-state[hidden] {
    display: none;
  }

  @media (max-width: 650px) {
    .search-page {
      width: min(100% - 24px, 900px);

      padding: 46px 0 80px;
    }

    .search-controls {
      grid-template-columns: 1fr;
    }

    .result-top {
      flex-direction: column;

      gap: 10px;
    }
  }
</style>
