---
import type {
  ImageMetadata,
} from "astro";

import {
  getImage,
} from "astro:assets";

interface Props {
  title: string;
  description?: string;

  pageType?: "website" | "article";

  publishedTime?: Date;
  updatedTime?: Date;

  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description =
    "William Chan 的个人网站和前端学习记录",

  pageType = "website",

  publishedTime,
  updatedTime,
  image,
  imageAlt,
} = Astro.props;

const baseURL =
  Astro.site ?? Astro.url.origin;

const optimizedSocialImage =
  image
    ? await getImage({
        src: image,
        width: 1200,
        height: 630,
        format: "jpg",
        fit: "cover",
      })
    : null;

const socialImageURL =
  optimizedSocialImage
    ? new URL(
        optimizedSocialImage.src,
        baseURL
      ).href
    : null;

const canonicalURL =
  new URL(
    Astro.url.pathname,
    baseURL
  );

const rssURL =
  new URL(
    "/rss.xml",
    baseURL
  );

const publishedISO =
  publishedTime?.toISOString();

const updatedISO =
  updatedTime?.toISOString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content="William Chan"
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <!-- 规范网址 -->
    <link
      rel="canonical"
      href={canonicalURL.href}
    />

    <!-- Sitemap 入口 -->
    <link
      rel="sitemap"
      href="/sitemap-index.xml"
    />

    <!-- RSS 自动发现 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="William Chan 的博客 RSS"
      href={rssURL.href}
    />
        {
      socialImageURL && (
        <>
          <meta
            property="og:image"
            content={socialImageURL}
          />

          <meta
            property="og:image:alt"
            content={
              imageAlt ??
              description
            }
          />

          <meta
            name="twitter:image"
            content={socialImageURL}
          />
        </>
      )
    }

    <!-- Open Graph -->
    <meta
      property="og:site_name"
      content="William Chan 的个人网站"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:type"
      content={pageType}
    />

    <meta
      property="og:url"
      content={canonicalURL.href}
    />

    <meta
      property="og:locale"
      content="zh_CN"
    />

    <!-- 基础 Twitter / X 卡片 -->
    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {
      pageType === "article" &&
      publishedISO && (
        <meta
          property="article:published_time"
          content={publishedISO}
        />
      )
    }

    {
      pageType === "article" &&
      updatedISO && (
        <meta
          property="article:modified_time"
          content={updatedISO}
        />
      )
    }

    <style is:global>
      * {
        box-sizing: border-box;
      }

      html {
        font-family:
          Inter,
          Arial,
          "Microsoft YaHei",
          sans-serif;

        background: #eef2ff;
        color: #16181d;
      }

      body {
        margin: 0;
      }

      button,
      input,
      textarea {
        font: inherit;
      }
    </style>
  </head>

  <body>
    <slot />
  </body>
</html>