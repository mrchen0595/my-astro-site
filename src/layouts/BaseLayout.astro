---
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";

import { siteConfig } from "../config/site";

import { createCanonicalUrl, createSiteUrl, getBaseUrl } from "../lib/url";

import "../styles/global.css";
import "../styles/accessibility.css";

import type { ImageMetadata } from "astro";

import { getImage } from "astro:assets";

interface Props {
  title: string;

  description?: string;

  pageType?: "website" | "article";

  publishedTime?: Date;

  updatedTime?: Date;

  image?: ImageMetadata;

  imageAlt?: string;
}

const {
  title,

  description = siteConfig.description,

  pageType = "website",

  publishedTime,

  updatedTime,

  image,

  imageAlt,
} = Astro.props;

const baseURL = getBaseUrl(Astro.site, Astro.url.origin);

const optimizedSocialImage = image
  ? await getImage({
      src: image,

      width: 1200,

      height: 630,

      format: "jpg",

      fit: "cover",
    })
  : null;

const socialImageURL = optimizedSocialImage
  ? createSiteUrl(optimizedSocialImage.src, baseURL)
  : null;

const canonicalURL = createCanonicalUrl(Astro.url.pathname, baseURL);

const rssURL = createSiteUrl("/rss.xml", baseURL);

const publishedISO = publishedTime?.toISOString();

const updatedISO = updatedTime?.toISOString();
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <script>
      (() => {
        const storageKey = "william-site-theme";

        const root = document.documentElement;

        let preference = "system";

        try {
          const savedPreference = localStorage.getItem(storageKey);

          if (
            savedPreference === "light" ||
            savedPreference === "dark" ||
            savedPreference === "system"
          ) {
            preference = savedPreference;
          }
        } catch {
          // 某些隐私模式可能禁止访问存储。
          // 此时直接使用系统主题。
        }

        const systemUsesDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        const resolvedTheme =
          preference === "system"
            ? systemUsesDark
              ? "dark"
              : "light"
            : preference;

        root.dataset.theme = resolvedTheme;

        root.dataset.themePreference = preference;
      })();
    </script>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="color-scheme" content="light dark" />

    <title>
      {title}
    </title>

    <meta name="description" content={description} />

    <meta name="author" content={siteConfig.author} />

    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalURL} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.rssTitle}
      href={rssURL}
    />

    {
      socialImageURL && (
        <>
          <meta property="og:image" content={socialImageURL} />

          <meta property="og:image:alt" content={imageAlt ?? description} />

          <meta name="twitter:image" content={socialImageURL} />
        </>
      )
    }

    <meta property="og:site_name" content={siteConfig.name} />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:type" content={pageType} />

    <meta property="og:url" content={canonicalURL} />

    <meta property="og:locale" content={siteConfig.openGraphLocale} />

    <meta name="twitter:card" content="summary" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    {
      pageType === "article" && publishedISO && (
        <meta property="article:published_time" content={publishedISO} />
      )
    }

    {
      pageType === "article" && updatedISO && (
        <meta property="article:modified_time" content={updatedISO} />
      )
    }
  </head>

  <body>
    <SkipLink />

    <slot />

    <Footer />
  </body>
</html>
