---
import Footer from "../components/Footer.astro";

import "../styles/global.css";

import type { ImageMetadata } from "astro";

import { getImage } from "astro:assets";

interface Props {
  title: string;
  description?: string;

  pageType?: "website" | "article";

  publishedTime?: Date;
  updatedTime?: Date;

  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description = "William Chan 的个人网站和前端学习记录",

  pageType = "website",

  publishedTime,
  updatedTime,
  image,
  imageAlt,
} = Astro.props;

const baseURL = Astro.site ?? Astro.url.origin;

const optimizedSocialImage = image
  ? await getImage({
      src: image,
      width: 1200,
      height: 630,
      format: "jpg",
      fit: "cover",
    })
  : null;

const socialImageURL = optimizedSocialImage
  ? new URL(optimizedSocialImage.src, baseURL).href
  : null;

const canonicalURL = new URL(Astro.url.pathname, baseURL);

const rssURL = new URL("/rss.xml", baseURL);

const publishedISO = publishedTime?.toISOString();

const updatedISO = updatedTime?.toISOString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      (() => {
        const storageKey = "william-site-theme";
        const root = document.documentElement;

        let preference = "system";

        try {
          const savedPreference = localStorage.getItem(storageKey);

          if (
            savedPreference === "light" ||
            savedPreference === "dark" ||
            savedPreference === "system"
          ) {
            preference = savedPreference;
          }
        } catch {
          // 某些隐私模式可能禁止访问存储。
          // 此时直接使用系统主题。
        }

        const systemUsesDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        const resolvedTheme =
          preference === "system"
            ? systemUsesDark
              ? "dark"
              : "light"
            : preference;

        root.dataset.theme = resolvedTheme;
        root.dataset.themePreference = preference;
      })();
    </script>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>

    <meta name="description" content={description} />

    <meta name="author" content="William Chan" />

    <meta name="robots" content="index, follow" />

    <!-- 规范网址 -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Sitemap 入口 -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RSS 自动发现 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="William Chan 的博客 RSS"
      href={rssURL.href}
    />
    {
      socialImageURL && (
        <>
          <meta property="og:image" content={socialImageURL} />

          <meta property="og:image:alt" content={imageAlt ?? description} />

          <meta name="twitter:image" content={socialImageURL} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:site_name" content="William Chan 的个人网站" />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:type" content={pageType} />

    <meta property="og:url" content={canonicalURL.href} />

    <meta property="og:locale" content="zh_CN" />

    <!-- 基础 Twitter / X 卡片 -->
    <meta name="twitter:card" content="summary" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    {
      pageType === "article" && publishedISO && (
        <meta property="article:published_time" content={publishedISO} />
      )
    }

    {
      pageType === "article" && updatedISO && (
        <meta property="article:modified_time" content={updatedISO} />
      )
    }
  </head>

  <body>
    <slot />

    <Footer />
  </body>
</html>
