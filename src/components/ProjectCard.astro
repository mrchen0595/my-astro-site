---
interface Props {
  id: string;
  title: string;
  description: string;
  technologies: string[];
  status?: string;
  href?: string;
}

const {
  id,
  title,
  description,
  technologies,
  status = "已完成",
  href,
} = Astro.props;

const detailHref = `/projects/${id}`;
---

<article class="project-card">
  <div class="card-header">
    <h2>
      {title}
    </h2>

    <span class="status">
      {status}
    </span>
  </div>

  <p class="description">
    {description}
  </p>

  <ul class="technology-list" aria-label={`${title} 使用的技术`}>
    {technologies.map((technology) => <li>{technology}</li>)}
  </ul>

  <div class="card-footer">
    <a class="detail-link" href={detailHref}>
      查看详情
      <span aria-hidden="true"> → </span>
    </a>

    {
      href ? (
        <a class="project-link" href={href}>
          打开项目
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="unavailable">暂未开放</span>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;

    flex-direction: column;

    min-width: 0;

    min-height: 360px;

    padding: 28px;

    overflow: hidden;

    border: 1px solid var(--color-border);

    border-radius: 20px;

    background: var(--color-surface);

    box-shadow: var(--shadow-card);

    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .project-card:hover {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 45%,
      var(--color-border)
    );

    transform: translateY(-4px);

    box-shadow: var(--shadow-card-hover);
  }

  .card-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 18px;

    min-width: 0;
  }

  h2 {
    min-width: 0;

    margin: 0;

    color: var(--color-text);

    font-size: 23px;

    line-height: 1.35;

    overflow-wrap: anywhere;
  }

  .status {
    flex-shrink: 0;

    padding: 6px 10px;

    border-radius: 999px;

    background: var(--color-accent-soft);

    color: var(--color-accent);

    font-size: 12px;

    font-weight: 800;

    line-height: 1.2;

    white-space: nowrap;
  }

  .description {
    margin: 20px 0 0;

    color: var(--color-muted);

    line-height: 1.75;

    overflow-wrap: anywhere;
  }

  .technology-list {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin: 24px 0 0;

    padding: 0;

    list-style: none;
  }

  .technology-list li {
    padding: 7px 10px;

    border-radius: 8px;

    background: var(--color-subtle);

    color: var(--color-text-soft);

    font-size: 13px;

    font-weight: 700;

    line-height: 1.25;
  }

  .card-footer {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 18px;

    min-height: 30px;

    margin-top: auto;

    padding-top: 30px;
  }

  .detail-link,
  .project-link {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    width: fit-content;

    min-height: 24px;

    font-weight: 800;

    text-decoration: none;
  }

  .detail-link {
    color: var(--color-accent);
  }

  .detail-link:hover {
    color: var(--color-accent-hover);

    text-decoration: underline;

    text-underline-offset: 4px;
  }

  .project-link {
    color: var(--color-text-soft);
  }

  .project-link:hover {
    color: var(--color-text);

    text-decoration: underline;

    text-underline-offset: 4px;
  }

  .unavailable {
    color: var(--color-disabled);

    font-weight: 800;
  }

  @media (max-width: 480px) {
    .project-card {
      min-height: 0;

      padding: 22px;
    }

    .card-header {
      flex-direction: column;

      gap: 12px;
    }

    .status {
      align-self: flex-start;
    }

    .card-footer {
      align-items: flex-start;

      flex-direction: column;

      gap: 12px;
    }
  }
</style>
