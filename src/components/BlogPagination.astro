---
import type { BlogPageData } from "../lib/blog";

interface Props {
  page: BlogPageData;
}

const { page } = Astro.props;

const shouldRender = page.totalPages > 1;
---

{
  shouldRender && (
    <nav class="pagination" aria-label="博客分页">
      <div class="pagination-side pagination-previous">
        {page.previousHref ? (
          <a href={page.previousHref}>
            <span aria-hidden="true">←</span>
            上一页
          </a>
        ) : (
          <span class="disabled">上一页</span>
        )}
      </div>

      <p class="pagination-status" aria-current="page">
        第 {page.currentPage} / {page.totalPages} 页
      </p>

      <div class="pagination-side pagination-next">
        {page.nextHref ? (
          <a href={page.nextHref}>
            下一页
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="disabled">下一页</span>
        )}
      </div>
    </nav>
  )
}

<style>
  .pagination {
    display: grid;

    grid-template-columns: 1fr auto 1fr;

    align-items: center;

    gap: 20px;

    margin-top: 42px;

    padding-top: 24px;

    border-top: 1px solid var(--color-border);
  }

  .pagination-side {
    display: flex;
  }

  .pagination-next {
    justify-content: flex-end;
  }

  a,
  .disabled {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    min-height: 44px;

    padding: 0 14px;

    border-radius: 10px;

    font-weight: 800;
  }

  a {
    border: 1px solid var(--color-border);

    color: var(--color-text);

    text-decoration: none;
  }

  a:hover {
    border-color: var(--color-accent);

    color: var(--color-accent);
  }

  .disabled {
    color: var(--color-muted);

    opacity: 0.55;
  }

  .pagination-status {
    margin: 0;

    color: var(--color-muted);

    font-size: 14px;

    font-weight: 700;

    text-align: center;
  }

  @media (max-width: 600px) {
    .pagination {
      grid-template-columns: 1fr 1fr;
    }

    .pagination-status {
      grid-column: 1 / -1;

      grid-row: 1;

      order: -1;
    }
  }
</style>
