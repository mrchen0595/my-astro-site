---
const currentPath =
  Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  {
    href: "/",
    label: "首页",
  },
  {
    href: "/projects",
    label: "项目",
  },
  {
    href: "/contact",
    label: "联系",
  },
  {
    href: "/about",
    label: "关于",
  },
];
---

<header class="site-header">
  <a class="logo" href="/">
    William Chan的个人网站
  </a>

  <nav aria-label="主导航">
    {
      links.map((link) => {
        const isActive = currentPath === link.href;

        return (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              { active: isActive },
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  .site-header {
    width: min(1100px, calc(100% - 40px));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    color: #16181d;
    font-size: 20px;
    font-weight: 800;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 8px;
  }

  .nav-link {
    padding: 9px 14px;
    border-radius: 9px;
    color: #676c78;
    text-decoration: none;
    transition:
      background 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }

  .nav-link:hover {
    background: #e8e7ff;
    color: #5145cd;
    transform: translateY(-1px);
  }

  .nav-link.active {
    background: #5145cd;
    color: white;
  }

@media (max-width: 680px) {
  .site-header {
    width: min(
      100% - 24px,
      1100px
    );
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 0;
  }

  .logo {
    font-size: 18px;
  }

  nav {
    width: 100%;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .nav-link {
    flex-shrink: 0;
    padding: 8px 11px;
    white-space: nowrap;
  }
}
</style>