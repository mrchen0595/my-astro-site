---
interface TagItem {
  name: string;
  count: number;
}

interface Props {
  tags: TagItem[];
  total: number;
}

const {
  tags,
  total,
} = Astro.props;
---

<section
  class="blog-tools"
  data-blog-filter
  aria-label="博客搜索和筛选"
>
  <form
    class="search-form"
    role="search"
  >
    <label for="blog-search">
      搜索文章
    </label>

    <div class="search-control">
      <input
        id="blog-search"
        type="search"
        name="q"
        placeholder="搜索标题、简介或标签"
        autocomplete="off"
      />

      <button
        id="clear-search"
        class="clear-button"
        type="button"
        hidden
      >
        清空
      </button>
    </div>
  </form>

  <div class="tag-filter">
    <p class="filter-title">
      按标签筛选
    </p>

    <div
      class="tag-buttons"
      role="group"
      aria-label="文章标签"
    >
      <button
        class="tag-button active"
        type="button"
        data-tag=""
        aria-pressed="true"
      >
        全部
        <span>{total}</span>
      </button>

      {
        tags.map((tag) => (
          <button
            class="tag-button"
            type="button"
            data-tag={tag.name}
            aria-pressed="false"
          >
            {tag.name}
            <span>{tag.count}</span>
          </button>
        ))
      }
    </div>
  </div>

  <p
    id="blog-result-count"
    class="result-count"
    aria-live="polite"
  >
    显示 {total} 篇文章
  </p>
</section>

<script>
  const filterRoot =
    document.querySelector<HTMLElement>(
      "[data-blog-filter]"
    );

  if (filterRoot) {
    const searchInput =
      filterRoot.querySelector<HTMLInputElement>(
        "#blog-search"
      );

    const clearButton =
      filterRoot.querySelector<HTMLButtonElement>(
        "#clear-search"
      );

    const resultCount =
      filterRoot.querySelector<HTMLElement>(
        "#blog-result-count"
      );

    const tagButtons = Array.from(
      filterRoot.querySelectorAll<HTMLButtonElement>(
        "[data-tag]"
      )
    );

    const postItems = Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-blog-item]"
      )
    );

    const emptyMessage =
      document.querySelector<HTMLElement>(
        "#blog-empty-message"
      );

    let activeTag = "";

    function normalize(
      value: string
    ): string {
      return value
        .trim()
        .toLocaleLowerCase("zh-CN");
    }

    function readTags(
      item: HTMLElement
    ): string[] {
      try {
        const value = JSON.parse(
          item.dataset.tags ?? "[]"
        );

        return Array.isArray(value)
          ? value.filter(
              (tag): tag is string =>
                typeof tag === "string"
            )
          : [];
      } catch {
        return [];
      }
    }

    function updateURL(): void {
      const url = new URL(
        window.location.href
      );

      const query =
        searchInput?.value.trim() ?? "";

      if (query) {
        url.searchParams.set(
          "q",
          query
        );
      } else {
        url.searchParams.delete("q");
      }

      if (activeTag) {
        url.searchParams.set(
          "tag",
          activeTag
        );
      } else {
        url.searchParams.delete("tag");
      }

      window.history.replaceState(
        {},
        "",
        `${url.pathname}${url.search}${url.hash}`
      );
    }

    function updateTagButtons(): void {
      tagButtons.forEach((button) => {
        const isActive =
          (button.dataset.tag ?? "") ===
          activeTag;

        button.classList.toggle(
          "active",
          isActive
        );

        button.setAttribute(
          "aria-pressed",
          String(isActive)
        );
      });
    }

    function applyFilters(
      updateAddress = true
    ): void {
      const query = normalize(
        searchInput?.value ?? ""
      );

      let visibleCount = 0;

      postItems.forEach((item) => {
        const title = normalize(
          item.dataset.title ?? ""
        );

        const description = normalize(
          item.dataset.description ?? ""
        );

        const tags = readTags(item);

        const searchableTags =
          tags.map(normalize);

        const searchableText = [
          title,
          description,
          ...searchableTags,
        ].join(" ");

        const matchesQuery =
          !query ||
          searchableText.includes(query);

        const matchesTag =
          !activeTag ||
          tags.includes(activeTag);

        const isVisible =
          matchesQuery && matchesTag;

        item.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (resultCount) {
        resultCount.textContent =
          `显示 ${visibleCount} 篇文章`;
      }

      if (emptyMessage) {
        emptyMessage.hidden =
          visibleCount !== 0;
      }

      if (clearButton) {
        clearButton.hidden =
          !searchInput?.value;
      }

      if (updateAddress) {
        updateURL();
      }
    }

    function setActiveTag(
      tag: string,
      updateAddress = true
    ): void {
      activeTag = tag;
      updateTagButtons();
      applyFilters(updateAddress);
    }

    searchInput?.addEventListener(
      "input",
      () => {
        applyFilters();
      }
    );

    filterRoot
      .querySelector("form")
      ?.addEventListener(
        "submit",
        (event) => {
          event.preventDefault();
          applyFilters();
        }
      );

    clearButton?.addEventListener(
      "click",
      () => {
        if (!searchInput) {
          return;
        }

        searchInput.value = "";
        searchInput.focus();
        applyFilters();
      }
    );

    tagButtons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          setActiveTag(
            button.dataset.tag ?? ""
          );
        }
      );
    });

    const initialParams =
      new URLSearchParams(
        window.location.search
      );

    const initialQuery =
      initialParams.get("q") ?? "";

    const requestedTag =
      initialParams.get("tag") ?? "";

    if (searchInput) {
      searchInput.value =
        initialQuery;
    }

    const tagExists =
      tagButtons.some(
        (button) =>
          button.dataset.tag ===
          requestedTag
      );

    activeTag =
      tagExists
        ? requestedTag
        : "";

    updateTagButtons();
    applyFilters(false);
  }
</script>

<style>
  .blog-tools {
    margin-top: 52px;
    padding: 26px;
    border: 1px solid #dfe2ea;
    border-radius: 20px;
    background:
      rgba(255, 255, 255, 0.75);
  }

  .search-form label,
  .filter-title {
    display: block;
    margin: 0 0 10px;
    color: #30343b;
    font-weight: 800;
  }

  .search-control {
    position: relative;
  }

  .search-control input {
    width: 100%;
    min-height: 50px;
    padding:
      0
      88px
      0
      15px;
    border: 1px solid #cfd3dd;
    border-radius: 11px;
    outline: none;
    background: white;
    color: #16181d;
  }

  .search-control input:focus {
    border-color: #5145cd;
    box-shadow:
      0 0 0 4px
      rgba(81, 69, 205, 0.12);
  }

  .clear-button {
    position: absolute;
    top: 50%;
    right: 10px;
    min-height: 34px;
    padding: 0 11px;
    border: 0;
    border-radius: 8px;
    background: #efeff5;
    color: #555b67;
    font-weight: 700;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .clear-button:hover {
    background: #e2e2eb;
  }

  .tag-filter {
    margin-top: 24px;
  }

  .tag-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .tag-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 13px;
    border: 1px solid #d9dce5;
    border-radius: 999px;
    background: white;
    color: #555b67;
    font-weight: 700;
    cursor: pointer;
  }

  .tag-button span {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: #f0f1f5;
    font-size: 12px;
  }

  .tag-button:hover {
    border-color: #9188e8;
    color: #5145cd;
  }

  .tag-button.active {
    border-color: #5145cd;
    background: #5145cd;
    color: white;
  }

  .tag-button.active span {
    background:
      rgba(255, 255, 255, 0.2);
    color: white;
  }

  .result-count {
    margin: 22px 0 0;
    color: #777d89;
    font-size: 14px;
  }

  @media (max-width: 600px) {
    .blog-tools {
      padding: 20px;
    }

    .tag-buttons {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 6px;
    }

    .tag-button {
      flex-shrink: 0;
    }
  }
</style>