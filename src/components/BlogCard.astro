---
import type {
  CollectionEntry,
} from "astro:content";

import BlogCover from
  "./BlogCover.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const formattedDate =
  new Intl.DateTimeFormat(
    "zh-CN",
    {
      year: "numeric",
      month: "long",
      day: "numeric",
    }
  ).format(post.data.pubDate);
---

<article class="blog-card">
  <a
    class="cover-link"
    href={`/blog/${post.id}`}
    aria-label={`阅读：${post.data.title}`}
  >
    <BlogCover
      src={post.data.cover}
      alt={post.data.coverAlt}
      variant="card"
    />
  </a>

  <div class="card-body">
    <p class="date">
      {formattedDate}
    </p>

    <h2>
      <a href={`/blog/${post.id}`}>
        {post.data.title}
      </a>
    </h2>

    <p class="description">
      {post.data.description}
    </p>

    {
      post.data.tags.length > 0 && (
        <ul
          class="tag-list"
          aria-label="文章标签"
        >
          {
            post.data.tags.map(
              (tag) => (
                <li>{tag}</li>
              )
            )
          }
        </ul>
      )
    }

    <a
      class="read-link"
      href={`/blog/${post.id}`}
    >
      阅读文章
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow:
      var(--shadow-card);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow:
      var(--shadow-card-hover);
  }

  .cover-link {
    display: block;
    overflow: hidden;
    background: var(--color-subtle);
  }

  .cover-link :global(.blog-cover.card) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .cover-link:hover
  :global(.blog-cover.card) {
    transform: scale(1.025);
  }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 28px;
  }

  .date {
    margin: 0;
    color: vvar(--color-muted);
    font-size: 14px;
  }

  h2 {
    margin: 14px 0 0;
    font-size: 25px;
    line-height: 1.4;
  }

  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-accent);
  }

  .description {
    margin: 16px 0 0;
    color: vvar(--color-muted);
    line-height: 1.75;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 6px 9px;
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 800;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 28px;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }
</style>