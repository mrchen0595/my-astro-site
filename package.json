{
  "name": "my-astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check --minimumFailingSeverity warning",
    "check:watch": "astro check --watch",
    "check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "quality": "npm run check && npm run check:e2e && npm run format:check && npm run build",
    "lighthouse": "npm run build && lhci autorun",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:open": "lhci open"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.4",
    "astro": "^7.1.6",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
