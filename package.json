{
  "name": "my-astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check --minimumFailingSeverity warning",
    "check:watch": "astro check --watch",
    "check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "quality": "npm run check:code && npm run test:unit && npm run build && npm run performance:budget",
    "lighthouse": "npm run build && lhci autorun",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:open": "lhci open",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "verify": "npm run quality && npm run test:e2e && npm run lighthouse",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:e2e",
    "check:code": "npm run check && npm run check:e2e && npm run format:check",
    "test:a11y": "playwright test e2e/accessibility.spec.ts e2e/focus-visible.spec.ts e2e/contact.spec.ts e2e/semantics.spec.ts e2e/reduced-motion.spec.ts e2e/contrast-status.spec.ts e2e/target-size.spec.ts e2e/reflow.spec.ts e2e/axe-accessibility.spec.ts",
    "performance:budget": "node scripts/check-performance-budget.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.4",
    "astro": "^7.1.6",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
